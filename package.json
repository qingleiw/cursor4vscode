{
  "name": "cursor4vscode",
  "displayName": "cursor4vscode (Unofficial Cursor Agent Panel)",
  "description": "Unofficial chat panel that runs a Cursor agent in the open folder. Not affiliated with Cursor or Anysphere. The Cursor SDK is downloaded from npm on first use.",
  "version": "0.2.0",
  "publisher": "qingleiwang",
  "license": "MIT",
  "icon": "media/icon.png",
  "keywords": [
    "cursor",
    "agent",
    "ai",
    "chat",
    "unofficial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/qingleiw/cursor4vscode"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "AI",
    "Chat"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "cursor4vscode-side",
          "title": "Cursor",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "cursor4vscode-side": [
        {
          "type": "webview",
          "id": "cursor4vscode.sideChat",
          "name": "Cursor"
        }
      ]
    },
    "commands": [
      {
        "command": "cursor4vscode.newChat",
        "title": "New Chat",
        "category": "cursor4vscode",
        "icon": "$(add)"
      },
      {
        "command": "cursor4vscode.openInEditor",
        "title": "Open in Editor",
        "category": "cursor4vscode"
      },
      {
        "command": "cursor4vscode.signIn",
        "title": "Sign In",
        "category": "cursor4vscode"
      },
      {
        "command": "cursor4vscode.signOut",
        "title": "Sign Out",
        "category": "cursor4vscode"
      },
      {
        "command": "cursor4vscode.selectModel",
        "title": "Select Model",
        "category": "cursor4vscode"
      },
      {
        "command": "cursor4vscode.compact",
        "title": "Compact Conversation",
        "category": "cursor4vscode"
      },
      {
        "command": "cursor4vscode.installSdk",
        "title": "Download or Update the Cursor SDK",
        "category": "cursor4vscode"
      }
    ],
    "configuration": {
      "title": "cursor4vscode",
      "properties": {
        "cursor4vscode.model": {
          "type": "string",
          "default": "composer-2.5",
          "description": "Cursor model id used for chat. Use cursor4vscode: Select Model to pick from your account."
        },
        "cursor4vscode.contextWindow": {
          "type": "number",
          "default": 200000,
          "minimum": 1000,
          "description": "Context window, in tokens, that the context indicator measures against. The Cursor SDK does not report a model's window, so set this to match the model you use."
        },
        "cursor4vscode.nodePath": {
          "type": "string",
          "default": "",
          "description": "Optional path to a Node.js 22.13 or newer binary. Leave empty to use the editor's own Node when it is new enough, otherwise node on PATH."
        },
        "cursor4vscode.sdkPath": {
          "type": "string",
          "default": "",
          "description": "Optional folder that already holds the Cursor SDK, that is, one with node_modules/@cursor/sdk inside. Leave empty to use the copy the extension downloads."
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --allow-missing-repository"
  },
  "devDependencies": {
    "@cursor/sdk": "^1.0.36",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.95.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "katex": "^0.19.0",
    "typescript": "^5.8.0"
  }
}
